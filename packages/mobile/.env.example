# Convex Backend URL (same as web app)
# Get this from your Convex dashboard or root .env.local
EXPO_PUBLIC_CONVEX_URL=https://compassionate-owl-382.convex.cloud

# WorkOS Configuration
# These should match your root .env.local values
EXPO_PUBLIC_WORKOS_CLIENT_ID=client_01KEEDZT73HXS19AZ0KQK4YW5D
EXPO_PUBLIC_WORKOS_CLIENT_SECRET=your_workos_client_secret
EXPO_PUBLIC_WORKOS_REDIRECT_URI=w-ai-mobile://auth/callback
EXPO_PUBLIC_WORKOS_DOMAIN=

# Web App URL (for signup redirect)
EXPO_PUBLIC_WEB_APP_URL=http://localhost:3000

# Salla API (if needed for mobile)
EXPO_PUBLIC_SALLA_CLIENT_ID=972824de-b108-4c31-9c4f-cdad5313533f
EXPO_PUBLIC_SALLA_REDIRECT_URI=https://giant-heron-232.convex.site/salla/callback

# Note: 
# - All mobile env vars must be prefixed with EXPO_PUBLIC_ to be accessible
# - Server-side secrets (WORKOS_API_KEY, WORKOS_COOKIE_PASSWORD, etc.) are backend-only
# - Copy this file to .env.local and fill in any missing values
