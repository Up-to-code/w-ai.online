# Convex Backend URL (same as web app)
EXPO_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# WorkOS Configuration
EXPO_PUBLIC_WORKOS_CLIENT_ID=your_workos_client_id
EXPO_PUBLIC_WORKOS_CLIENT_SECRET=your_workos_client_secret
EXPO_PUBLIC_WORKOS_REDIRECT_URI=w-ai-mobile://auth/callback
EXPO_PUBLIC_WORKOS_DOMAIN=your_workos_domain

# Web App URL (for signup redirect)
EXPO_PUBLIC_WEB_APP_URL=https://w-ai.online
